__pycache__/
*.pyc

# Scan output -- contains real network data, don't commit it.
# Root-anchored (leading /) so these patterns don't also match same-named
# files elsewhere in the repo, e.g. docs/screenshots/topology.png or
# eval/example_synthetic_scan.json -- those ARE meant to be committed.
/scan_results.json
/history/
/topology.html
/topology.png
/report.html
/attack_navigator_layer.json
/known_devices.json

# Local caches
/cve_cache.db
/osint_cache.db
/epss_cache.db
/oui_cache.db

# Generated by eval/evaluate.py -- user-specific findings, not committed by default
/eval/manual_review_worksheet.csv

.env
